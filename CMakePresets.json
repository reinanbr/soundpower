{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "host-debug",
      "displayName": "Host Debug",
      "inherits": "host-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "host-release",
      "displayName": "Host Release",
      "inherits": "host-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "host-asan",
      "displayName": "Host AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "host-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SP_SANITIZE": "address,undefined" }
    },
    {
      "name": "host-tsan",
      "displayName": "Host ThreadSanitizer",
      "inherits": "host-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SP_SANITIZE": "thread" }
    },
    {
      "name": "host-fuzz",
      "displayName": "Host libFuzzer (Clang, ASan + UBSan)",
      "inherits": "host-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "SP_SANITIZE": "address,undefined",
        "SP_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_static",
        "SP_BUILD_TESTS": "ON",
        "SP_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (NDK r28; ctest runs on the device over adb)",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "CMAKE_CROSSCOMPILING_EMULATOR": "${sourceDir}/scripts/adb-exec.sh;arm64-v8a"
      }
    },
    {
      "name": "android-armv7",
      "displayName": "Android armeabi-v7a (NDK r28; ctest runs on the device over adb)",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "armeabi-v7a",
        "CMAKE_CROSSCOMPILING_EMULATOR": "${sourceDir}/scripts/adb-exec.sh;armeabi-v7a"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug" },
    { "name": "host-release", "configurePreset": "host-release" },
    { "name": "host-asan", "configurePreset": "host-asan" },
    { "name": "host-tsan", "configurePreset": "host-tsan" },
    { "name": "host-fuzz", "configurePreset": "host-fuzz" },
    { "name": "android-arm64", "configurePreset": "android-arm64" },
    { "name": "android-armv7", "configurePreset": "android-armv7" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 600 }
    },
    { "name": "host-debug", "inherits": "test-base", "configurePreset": "host-debug" },
    { "name": "host-release", "inherits": "test-base", "configurePreset": "host-release" },
    { "name": "host-asan", "inherits": "test-base", "configurePreset": "host-asan" },
    { "name": "host-tsan", "inherits": "test-base", "configurePreset": "host-tsan" },
    { "name": "host-fuzz", "inherits": "test-base", "configurePreset": "host-fuzz" },
    { "name": "android-arm64", "inherits": "test-base", "configurePreset": "android-arm64" },
    { "name": "android-armv7", "inherits": "test-base", "configurePreset": "android-armv7" }
  ]
}
