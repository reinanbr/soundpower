#!/sbin/sh
# Standard Magisk module installer entry point (the same logic as Magisk's
# scripts/module_installer.sh): load Magisk's installer functions and run install_module, which
# sources customize.sh.

umask 022

ui_print() { echo "$1"; }

require_new_magisk() {
    ui_print "*******************************"
    ui_print " Please install Magisk v24.0+! "
    ui_print "*******************************"
    exit 1
}

# Read by util_functions.sh.
# shellcheck disable=SC2034
OUTFD=$2
# shellcheck disable=SC2034
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
# shellcheck source=/dev/null
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 24000 ] && require_new_magisk

install_module
exit 0
