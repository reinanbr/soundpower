    <!-- Engine choice: with root (the Magisk module) or without (Android's own effect). -->
    <string name="engine_choice_title">How should SoundPower work?</string>
    <string name="engine_choice_intro">SoundPower can run its own audio engine, installed with a Magisk module, or drive the effect built into Android, which needs no root.</string>
    <string name="engine_root">With root</string>
    <string name="engine_root_summary">SoundPower\'s own engine inside the system audio service.</string>
    <string name="engine_root_point_features">Every feature: mid and side bands, stereo width, mono, a peak limiter</string>
    <string name="engine_root_point_boot">Works from boot in every app, even when SoundPower is closed</string>
    <string name="engine_root_point_needs">Needs a rooted phone with Magisk</string>
    <string name="engine_rootless">Without root</string>
    <string name="engine_rootless_summary">Android\'s Dynamics Processing effect, driven by this app.</string>
    <string name="engine_rootless_point_any">Works on any phone with Android 9 or newer</string>
    <string name="engine_rootless_point_features">Graphic and parametric bands, bass and treble, preamp, balance, compressor and limiter</string>
    <string name="engine_rootless_point_limits">No mid or side bands, width or mono; a notification stays while it is on; some phones or apps bypass it</string>
    <string name="engine_choice_later">You can change this later in the menu.</string>
    <string name="action_continue">Continue</string>
    <string name="action_change_engine">Choose another mode</string>
    <string name="setup_try_rootless">No root? SoundPower also works without it, with fewer features.</string>

